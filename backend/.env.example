PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:password@localhost:5432/ecommerce_db?schema=public"

JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Razorpay Payment Gateway Keys (replace with your Razorpay Dashboard API Keys)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecret"

# Frontend Application URL
FRONTEND_URL="http://localhost:3000"

# SMTP Mail Server Configuration (Gmail / Brevo / Custom SMTP Server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="E-Commerce Store <notifications@yourdomain.com>"
